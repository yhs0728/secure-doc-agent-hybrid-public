# Copy to .env.microservices, or run tools/prepare_microservices_env.py.
# Every application has its own role. Application containers never receive POSTGRES_PASSWORD.
POSTGRES_DB=secure_doc_agent
POSTGRES_USER=secure_doc_admin
POSTGRES_PASSWORD=replace-with-a-random-administrator-password
IDENTITY_DB_PASSWORD=replace-with-a-unique-identity-password
KNOWLEDGE_DB_PASSWORD=replace-with-a-unique-knowledge-password
CONVERSATION_DB_PASSWORD=replace-with-a-unique-conversation-password
AUTH_JWT_SECRET=replace-with-a-random-signing-secret-at-least-32-characters
KNOWLEDGE_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters
REDIS_PASSWORD=replace_with_a_random_url_safe_secret_at_least_32_characters
CAPACITY_BACKEND=redis
REDIS_NAMESPACE=secure-doc
LLM_CAPACITY_POOL=default
LLM_SLOT_TTL_SECONDS=900
RAG_RATE_LIMIT_REQUESTS=30
RAG_RATE_LIMIT_WINDOW_SECONDS=60
BOOTSTRAP_ADMIN_EMAIL=admin@secure-doc.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
MINIO_ROOT_USER=secure-doc-storage
MINIO_ROOT_PASSWORD=replace-with-a-random-storage-password
OBJECT_STORAGE_BUCKET=secure-documents
LLM_API_KEY=ollama
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Optional, only for compose.validation.cpu.yaml (Windows WSL adapter IP or Docker host).
# VALIDATION_CPU_LLM_URL=http://host.docker.internal:11435/v1
LLM_TIMEOUT_SECONDS=300
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_TIMEOUT_SECONDS=5
APP_ENVIRONMENT=development
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=3
WORKER_REPLICAS=2
IDENTITY_IMAGE_TAG=1.0.0
KNOWLEDGE_IMAGE_TAG=1.0.0
CONVERSATION_IMAGE_TAG=1.0.0
WEB_IMAGE_TAG=1.0.0

# Character cap for prior chat context (0 disables; hard maximum 8000).
LLM_HISTORY_MAX_CHARACTERS=2000
