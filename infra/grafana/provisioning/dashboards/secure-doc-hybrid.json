      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "secure_doc_finops_input_tokens{period=\"day\"}",
          "legendFormat": "input",
          "refId": "A"
        },
        {
          "expr": "secure_doc_finops_output_tokens{period=\"day\"}",
          "legendFormat": "output",
          "refId": "B"
        }
      ]
    }
  ]
