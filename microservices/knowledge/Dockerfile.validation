# Local acceptance-test fallback when rebuilding the large dependency layer fails.
# Production and CI keep using the independent Dockerfile/requirements build.
ARG VALIDATION_BASE_IMAGE=secure-doc-agent-api:latest
FROM ${VALIDATION_BASE_IMAGE}
ENV HF_HOME=/home/service/.cache/huggingface
USER root
RUN useradd --create-home service
RUN mkdir -p /home/service/.cache/huggingface && chown -R service:service /home/service/.cache
WORKDIR /srv
COPY knowledge_service ./knowledge_service
USER service
CMD ["python", "-m", "uvicorn", "knowledge_service.app:app", "--host", "0.0.0.0", "--port", "8000"]
