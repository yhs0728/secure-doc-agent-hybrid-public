LLM_API_KEY=your-api-key
LLM_MODEL=qwen3:4b-instruct
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
APP_ENVIRONMENT=development

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

SOURCE_DIRECTORY=data/source
INDEX_DIRECTORY=data/index
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=3

API_ACCESS_KEY=replace-with-secure-api-key
LOG_LEVEL=INFO

# PostgreSQL은 마이그레이션을 실행한 뒤 활성화합니다.
DATABASE_ENABLED=false
DATABASE_URL=postgresql+psycopg://secure_doc:change-me@localhost:5432/secure_doc_agent
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DEFAULT_WORKSPACE_ID=00000000-0000-7000-8000-000000000003
SYSTEM_USER_ID=00000000-0000-7000-8000-000000000001

# LOCAL, S3 또는 MINIO
OBJECT_STORAGE_BACKEND=LOCAL
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=secure-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=change-me-object-storage-secret
OBJECT_STORAGE_SECURE=false

# FAISS 또는 OPENSEARCH
SEARCH_BACKEND=FAISS
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_CA_CERTS=
OPENSEARCH_INDEX_PREFIX=secure-doc
OPENSEARCH_NUMBER_OF_REPLICAS=0

OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_SECONDS=2
WORKER_STALE_AFTER_SECONDS=300

# compose.yaml의 로컬 PostgreSQL 초기화 값입니다.
POSTGRES_DB=secure_doc_agent
POSTGRES_USER=secure_doc
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-object-storage-secret

# 운영 환경에서는 production으로 바꾸고 아래 조건을 모두 충족해야 시작됩니다.
# APP_ENVIRONMENT=production
# ALLOW_LEGACY_API_KEY=false
# AUTH_JWT_SECRET=<32자 이상의 무작위 값>
# OBJECT_STORAGE_SECURE=true
# OPENSEARCH_URL=https://opensearch.example.com:9200
# OPENSEARCH_USERNAME=<전용 서비스 계정>
# OPENSEARCH_PASSWORD=<16자 이상의 무작위 값>
# OPENSEARCH_VERIFY_CERTS=true
# OPENSEARCH_CA_CERTS=/run/secrets/opensearch-ca.pem
