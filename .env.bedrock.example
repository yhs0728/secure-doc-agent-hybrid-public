# Copy to .env.bedrock; never commit the real key.
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_ID=qwen.qwen3-32b
BEDROCK_API_KEY=
LLM_ANSWER_MAX_TOKENS=1024
LLM_MAX_CONCURRENCY=1
# Empty = deny external inference for every workspace. No wildcard.
# Only allow dedicated workspaces whose entire contents permit external processing.
HYBRID_EXTERNAL_WORKSPACES=
HYBRID_CIRCUIT_FAILURES=3
HYBRID_CIRCUIT_COOLDOWN_SECONDS=30
HYBRID_INFERENCE_BUDGET_SECONDS=90
LLM_TIMEOUT_SECONDS=30

# Shared per-stage call limits; a question may use multiple calls. UTC periods.
FINOPS_DAILY_CALL_LIMIT=60
FINOPS_MONTHLY_CALL_LIMIT=600
# Conservative reservation controls, not AWS billing limits or list prices.
FINOPS_DAILY_CONTROL_USD=1
FINOPS_MONTHLY_CONTROL_USD=20
FINOPS_CONTROL_INPUT_USD_PER_M=1
FINOPS_CONTROL_OUTPUT_USD_PER_M=5
FINOPS_MAX_INPUT_BYTES=32000
FINOPS_MAX_OUTPUT_TOKENS=1024
